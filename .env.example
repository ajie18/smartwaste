APP_NAME=SmartWaste
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smartwaste
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync

# Sanctum issues the API tokens the frontend stores in localStorage as
# `token` (see resources/views/auth/login.blade.php). Add the
# hosts/ports the frontend is served from if they differ from APP_URL.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

# App\Services\SmsService (IPROG SMS API) - forgot-password PIN + pickup-day
# notices. Leave blank in dev; SmsService logs the message instead of
# failing when unset. Docs: https://sms.iprogtech.com/api/v1/documentation
IPROG_API_TOKEN=

# App\Services\AiInsightService (Groq) - AI Insights panel on
# the admin Analytics page + per-report triage suggestions. Leave blank in
# dev; the service returns a "not configured" message instead of failing.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Real-time (App\Events\RealtimeEvent via Laravel Reverb). The driver
# dashboard's Echo bridge (public/js/driver/echo-bridge.js) connects using
# the REVERB_APP_KEY/HOST/PORT/SCHEME values below — keep them in sync with
# whatever `php artisan reverb:start` is actually listening on.
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=smartwaste
REVERB_APP_KEY=smartwaste-key
REVERB_APP_SECRET=smartwaste-secret
REVERB_HOST=localhost
REVERB_PORT=8082
REVERB_SCHEME=http

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8082
