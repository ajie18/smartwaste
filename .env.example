APP_NAME=SmartWaste
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/smartwaste-local.sqlite
# For MySQL instead, set DB_CONNECTION=mysql and configure DB_HOST, DB_PORT,
# DB_DATABASE, DB_USERNAME, and DB_PASSWORD for a database you have created.

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync


SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

IPROG_API_TOKEN=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

BROADCAST_CONNECTION=log

REVERB_APP_ID=smartwaste
REVERB_APP_KEY=smartwaste-key
REVERB_APP_SECRET=smartwaste-secret
REVERB_HOST=localhost
REVERB_PORT=8082
REVERB_SCHEME=http

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8082
